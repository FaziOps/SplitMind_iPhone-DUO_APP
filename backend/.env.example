# Copy to .env and adjust. Never commit .env.

PORT=8787

# mock   -> deterministic local responses, no API key needed (default)
# gemini -> Google Gemini via REST; requires GEMINI_API_KEY and GEMINI_MODEL
AI_PROVIDER=mock

# Only used when AI_PROVIDER=gemini. Use a paid-tier key so prompts are not
# used for training (PRD NFR-7). Confirm the live model id at build time --
# model names change often (PRD Section 7); the value below is an example.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Secret used to sign app-issued user tokens. REQUIRED outside development.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# NFR-5: cost and rate control
DAILY_QUOTA=200
MIN_REQUEST_INTERVAL_MS=1000
DEDUPE_WINDOW_MS=15000
MAX_TEXT_CHARS=8000
UPSTREAM_TIMEOUT_MS=25000

# Simulated latency for the mock provider
MOCK_LATENCY_MS=500
